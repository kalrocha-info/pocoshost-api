{
  "name": "pocoshost-api",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "node -e \"console.log('pocoshost-api: no build step')\"",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"*.mjs\" \"*.cjs\" --no-error-on-unmatched-pattern --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "verify-webhook": "node scripts/verify_webhook.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "streamifier": "^0.1.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "src/**/*.js": "eslint --fix --max-warnings=0",
    "test/**/*.js": "eslint --fix --max-warnings=0",
    "*.mjs": "eslint --fix --max-warnings=0",
    "*.cjs": "eslint --fix --max-warnings=0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
